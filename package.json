{
  "name": "dsh-wsl-sandbox",
  "version": "0.1.0",
  "description": "Codex-grade WSL 2 execution backend & OS sandbox for DeepSeek Harness (DSH) with single-shell dialect guard, zero-token Bash/PowerShell approval, physical hardware single-shot lock, and zero host plugin conflicts.",
  "icon": "./icon.svg",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0",
    "dsh": ">=0.2.1-rc.1 <0.3.0"
  },
  "main": "./dist/packages/dsh-plugin/src/index.js",
  "exports": {
    ".": "./dist/packages/dsh-plugin/src/index.js",
    "./client": "./client.js",
    "./web-ui": "./dist/packages/dsh-plugin/src/web-ui-entry.js",
    "./core": "./dist/packages/core/src/index.js",
    "./runner": "./dist/packages/wsl-runner/src/main.js",
    "./doctor": "./dist/packages/bootstrap/src/doctor.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "bin": {
    "dsh-wsl-doctor": "./dist/packages/bootstrap/src/doctor.js",
    "dsh-wsl-runner": "./dist/packages/wsl-runner/src/main.js"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.1-rc.1 <0.3.0",
      "profiles": [
        "desktop",
        "web",
        "headless"
      ]
    }
  },
  "files": [
    "dist",
    "client.js",
    "icon.svg",
    "locale",
    "cordis.patch.yml",
    "scripts/build.mjs",
    "packages/bootstrap/provision-wsl.sh",
    "packages/bootstrap/templates",
    "packages/bootstrap/prompts",
    "packages/bootstrap/install-dsh-plugin.ps1",
    "docs",
    "tests/windows-wsl-verify",
    ".agents/skills",
    "AGENTS.md",
    "INSTALL.zh.md",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node --test tests/unit/*.test.ts tests/plugin-coexistence/*.test.ts tests/linux-sandbox/*.test.ts",
    "test:unit": "node --test tests/unit/*.test.ts",
    "test:coexistence": "node --test tests/plugin-coexistence/*.test.ts",
    "test:linux-sandbox": "node --test tests/linux-sandbox/*.test.ts",
    "doctor": "node packages/bootstrap/src/doctor.ts",
    "doctor:json": "node packages/bootstrap/src/doctor.ts --json"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "wsl2",
    "sandbox",
    "bubblewrap",
    "seccomp",
    "windows"
  ]
}
