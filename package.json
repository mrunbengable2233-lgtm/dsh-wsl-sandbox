{
  "name": "dsh-wsl-sandbox",
  "version": "0.2.0",
  "description": "Codex-grade WSL 2 execution backend & OS sandbox for DeepSeek Harness (DSH) with shared DSH/WSL Node 22/24 runtime, SSD-safe coalesced structured logging, single-shell dialect guard, zero-token Bash/PowerShell approval, physical hardware single-shot lock, and zero host plugin conflicts.",
  "icon": "./icon.svg",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=20.11.0",
    "dsh": ">=0.2.1-0 <1.0.0-0"
  },
  "main": "./dist/packages/dsh-plugin/src/index.js",
  "exports": {
    ".": "./dist/packages/dsh-plugin/src/index.js",
    "./client": "./client.js",
    "./web-ui": "./dist/packages/dsh-plugin/src/web-ui-entry.js",
    "./core": "./dist/packages/core/src/index.js",
    "./runner": "./dist/packages/wsl-runner/src/main.js",
    "./doctor": "./dist/packages/bootstrap/src/doctor.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "bin": {
    "dsh-wsl-doctor": "./dist/packages/bootstrap/src/doctor.js",
    "dsh-wsl-runner": "./dist/packages/wsl-runner/src/main.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.1-0 <1.0.0-0",
      "profiles": [
        "desktop",
        "web",
        "headless"
      ]
    }
  },
  "files": [
    "dist/packages",
    "client.js",
    "icon.svg",
    "locale",
    "cordis.patch.yml",
    "packages/bootstrap",
    "scripts/stage-wsl-runner.mjs",
    "scripts/build.mjs",
    ".agents/skills/dsh-wsl-env-setup",
    "docs",
    "LICENSE",
    "INSTALL.zh.md",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:unit": "node scripts/run-tests.mjs --suite unit",
    "test:coexistence": "node scripts/run-tests.mjs --suite coexistence",
    "test:linux-sandbox": "node scripts/run-tests.mjs --suite linux-sandbox",
    "doctor": "node scripts/build.mjs && node dist/packages/bootstrap/src/doctor.js",
    "doctor:json": "node scripts/build.mjs && node dist/packages/bootstrap/src/doctor.js --json",
    "fuzz:check": "node scripts/run-dangerous-cmd-matrix.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "wsl2",
    "sandbox",
    "bubblewrap",
    "seccomp",
    "windows"
  ]
}
